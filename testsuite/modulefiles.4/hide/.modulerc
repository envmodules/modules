#%Module
if {[info exists env(TESTSUITE_HIDE)]} {
    switch -- $env(TESTSUITE_HIDE) {
        hide_modulefile_bad1 {
            hide-modulefile
        }
        hide_modulefile_bad2 {
            hide-modulefile path1 path2
        }
        hide_modulefile1 {
            hide-modulefile [file dirname $ModulesCurrentModulefile]/1
        }
        hide_modulefile2 {
            hide-modulefile hide/1
        }
        hide_modulefile3 {
            hide-modulefile hide
        }
        hide_modulefile4 {
            hide-modulefile hid
        }
        hide_version_bad1 {
            hide-version
        }
        hide_version_bad2 {
            hide-version path1 path2
        }
        hide_version1 {
            hide-version [file dirname $ModulesCurrentModulefile]/1
        }
        hide_version2 {
            hide-version hide/1
        }
        hide_version3 {
            hide-version hide
        }
        hide_version4 {
            hide-version hid
        }
        hide_regex_bad1 {
            module-hide-regex
        }
        hide_regex_bad2 {
            module-hide-regex {hide/(1}
        }
        hide_regex1 {
            module-hide-regex {^hide/1$}
        }
        hide_regex2 {
            module-hide-regex --hard {-unk$} {^HIDE/2}
        }
        hide_regex3 {
            module-hide-regex {^hide/} --user unknownuser
        }
        forbid_regex_bad1 {
            module-forbid-regex --message my-forbid-msg
        }
        forbid_regex1 {
            module-forbid-regex {-unk$} --message my-forbid-msg {^hide/2}
        }
        forbid_regex2 {
            set tomorrow [clock format [expr {[clock seconds]+86400}] -format %Y-%m-%d]
            module-forbid-regex --after $tomorrow {^hide/1}
        }
    }
}
