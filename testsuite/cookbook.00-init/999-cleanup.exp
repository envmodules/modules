# remove the sandbox holding every recipe's fixture tree (see
# 005-init_ts.exp), including the sandboxed $HOME set up in 010-environ.exp
if {$verbose} {
   send_user "\tDeleting $cookbooksandbox\n"
}
file delete -force $cookbooksandbox

