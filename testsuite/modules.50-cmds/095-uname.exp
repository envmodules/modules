##############################################################################
#   Modules Revision 3.0
#   Providing a flexible user environment
#
#   File:		modules.50-cmds/%M%
#   Revision:		%I%
#   First Edition:	1995/12/06
#   Last Mod.:		%U%, %G%
#
#   Authors:		Jens Hamisch, Jens.Hamisch@Strawberry.COM
#
#   Description:	Testuite testsequence
#   Command:		load
#   Modulefiles:	uname
#   Sub-Command:
#
#   Comment:	%C{
#			Tests the 'uname' module command
#		}C%
#
##############################################################################

skip_if_quick_mode

#
#  Check the configuration
#

set u_sysname $tcl_platform(os)
set u_release $tcl_platform(osVersion)
set u_machine $tcl_platform(machine)


#
#  set up variables relative to uname check
#

set uname_warn "$error_msgs: Command 'uname' cannot be found"

#  check where to find the 'uname' binary on this system
set uname [auto_execok uname]
if {$uname eq ""} {
    if {$verbose} {
        send_user "\tNo executable 'uname' binary found ...\n"
    }
    set u_nodename "unknown"
    set u_version "unknown"
} else {
    if {$verbose} {
        send_user "\tUsing '$uname' for uname checking ...\n"
    }
	set u_nodename [exec $uname -n]
	set u_version [exec $uname -v]
}

#
#  set up variables relative to domainname check
#

if {$domainname eq ""} {
    if {$verbose} {
        send_user "\tNo executable '$install_domainname' found ...\n"
    }
    set u_domain "unknown"
} else {
    if {$verbose} {
        send_user "\tUsing '$install_domainnamecmd' for domainname checking ...\n"
    }
    set u_domain [exec {*}$install_domainnamecmd]
}

#
#  Verbosity
#

if {$verbose} {
    send_user "   Uname defaults:\n"
    send_user "        system name      $u_sysname\n"
    send_user "        node name        $u_nodename\n"
    send_user "        domain name      $u_domain\n"
    send_user "        release          $u_release\n"
    send_user "        version          $u_version\n"
    send_user "        machine          $u_machine\n"
}

# ensure auto symbolic versions are not set for these tests
setenv_var MODULES_ADVANCED_VERSION_SPEC 0

#
#  Variables. This test forces a module load command. It will result in the
#    environment variables "_LMFILES_", "LOADEDMODULES" and "testsuite" to
#    be set up
#

set module "uname"
set modulefile "$modpath/$module"

#
#  The tests
#

regsub -all \# $u_version {\\\#} u_version
switch -- $os_name {
    {darwin} {
        regsub -all {;} $u_version {\\\;} u_version
    }
}
regsub -all { } $u_version {\\\ } u_version
regsub -all {\(} $u_version {\\\\\(} u_version
regsub -all {\)} $u_version {\\\\\)} u_version
regsub -all {\+} $u_version {\\+} u_version
regsub -all {\(} $u_domain {\\\\\(} u_domain
regsub -all {\)} $u_domain {\\\\\)} u_domain
regsub -all {\(} $u_release {\\\\\(} u_release
regsub -all {\)} $u_release {\\\\\)} u_release
regsub -all {\+} $u_release {\\+} u_release


foreach field [list sysname release machine] {
    set ans [list]
    lappend ans [list set _LMFILES_ "$modulefile/$field"]
    lappend ans [list set LOADEDMODULES "$module/$field"]
    lappend ans [list set testsuite [set "u_$field"] noescval]
    test_cmd_re "csh" "load $module/$field" $ans
}

foreach field [list nodename version] {
    if {$uname ne ""} {
        set ans [list]
        lappend ans [list set _LMFILES_ "$modulefile/$field"]
        lappend ans [list set LOADEDMODULES "$module/$field"]
        lappend ans [list set testsuite [set "u_$field"] noescval]
        test_cmd_re "csh" "load $module/$field" $ans
    } else {
        testouterr_cmd "csh" "load $module/$field" "ERR" [msg_load $module/$field $uname_warn]
    }
}

if {$domainname ne ""} {
    set ans [list]
    lappend ans [list set _LMFILES_ "$modulefile/domain"]
    lappend ans [list set LOADEDMODULES "$module/domain"]
    lappend ans [list set testsuite $u_domain noescval]
	test_cmd_re "csh" "load $module/domain" $ans
} else {
    testouterr_cmd "csh" "load $module/domain" "ERR" [msg_load $module/domain $domainname_warn]
}

# check internal uname value cache mechanism
set ans [list]
lappend ans [list set testsuite2 [set "u_machine"] noescval]
lappend ans [list set _LMFILES_ "$modulefile/cache"]
lappend ans [list set LOADEDMODULES "$module/cache"]
lappend ans [list set testsuite1 [set "u_machine"] noescval]
test_cmd_re "csh" "load $module/cache" $ans

# bad uname subcommand
set custom {uname unk}
if {[cmpversion $tclsh_version 8.6] == -1} {
append custom {"
    invoked from within
"setenv testsuite "[uname unk]"}
}
testouterr_cmd "csh" "load $module/unk" "ERR" [msg_load $module/unk [msg_moderr {uname unk not supported} $custom $modulefile/unk 26]]

# setup an empty path
if {$verbose} {
    send_user "\tSetup PATH = \n"
}
set env(PATH) ""

# no change for these fields
foreach field [list sysname release machine] {
    set ans [list]
    lappend ans [list set _LMFILES_ "$modulefile/$field"]
    lappend ans [list set LOADEDMODULES "$module/$field"]
    lappend ans [list set testsuite [set "u_$field"] noescval]
    test_cmd_re "csh" "load $module/$field" $ans
}

# cannot find bin for those fields
foreach field [list nodename version] {
    testouterr_cmd "csh" "load $module/$field" "ERR" [msg_load $module/$field $uname_warn]
}

if {$domainname ne {} && [is_full_path $install_domainname]} {
    set ans [list]
    lappend ans [list set _LMFILES_ "$modulefile/domain"]
    lappend ans [list set LOADEDMODULES "$module/domain"]
    lappend ans [list set testsuite $u_domain noescval]
	testouterr_cmd_re "csh" "load $module/domain" $ans {}
} else {
    testouterr_cmd "csh" "load $module/domain" "ERR" [msg_load $module/domain $domainname_warn]
}


#
#  Cleanup
#

reset_test_env
