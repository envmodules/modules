# display
set tserr "$modlin
$mpre/$mod:

append-path\t--priority 100 FOO /path/to/foo
$modlin"
testouterr_cmd_re sh "display $mod" OK $tserr


#
# multiple appended elements with priority, --priority=N form
#

setenv_var TESTSUITE_PATH_PRIO append2

setenv_var FOO /bin:/path/to/baz
setenv_var __MODULES_PRIORITY_FOO "/path/to/baz&other/1.0|100"
