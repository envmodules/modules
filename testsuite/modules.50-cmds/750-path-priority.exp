lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|1000:/path/to/foo&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}

setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|10"
