##############################################################################
#   Modules Revision 3.0
#   Providing a flexible user environment
#
#   File:		modules.50-cmds/%M%
#   Revision:		%I%
#   First Edition:	2026/11/04
#   Last Mod.:		%U%, %G%
#
#   Authors:		Xavier Delaruelle, xavier.delaruelle@cea.fr
#
#   Description:	Testuite testsequence
#   Command:		load, unload, display, help, test, whatis, refresh, avail
#   Modulefiles:    path-prio
#   Sub-Command:
#
#   Comment:	%C{
#         Test --priority option of prepend-path and append-path modulefile
#         commands
#		}C%
#
##############################################################################

set mp $modpath.5
set mpre [regsub -all "\(\[.+?\]\)" $mp {\\\1}]
setenv_path_var MODULEPATH $mp

set mod path-prio/1.0
set modfile $mp/path-prio/1.0

# tests are made with path_entry_reorder disabled unless otherwise set
setenv_var MODULES_PATH_ENTRY_REORDER 0


#
# prepended element with priority goes first
#

setenv_var TESTSUITE_PATH_PRIO prepend1

setenv_var FOO /path/to/bar:/bin
unsetenv_var __MODULES_PRIORITY_FOO
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# variable not defined yet
unsetenv_var FOO
set ans [list]
lappend ans [list set FOO /path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# other element with higher priority already in variable
setenv_var FOO /path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-1000"
set ans [list]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-1000:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# other element with lower priority already in variable
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10"
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# other element with same priority already in variable
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100"
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

skip_if_quick_mode

# other appended element with priority already in variable
setenv_var FOO /bin:/path/to/bar
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100"
set ans [list]
lappend ans [list set FOO /path/to/foo:/bin:/path/to/bar]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# element already in variable without priority: no demand recorded when
# path_entry_reorder is disabled as element is not moved when added again
setenv_var FOO /path/to/bar:/path/to/foo:/bin
unsetenv_var __MODULES_PRIORITY_FOO
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
testouterr_cmd sh "load $mod" $ans {}

# element gets the priority when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# variable modified outside of module command is reordered
setenv_var FOO /path/to/baz:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/baz:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# stale or erroneous record entries are dropped
setenv_var FOO /path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/gone&other/1.0|-10:/path/to/bar&other/1.0|abc:/bin&other/1.0|0:/bin&other/1.0"
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# unload
setenv_loaded_module [list $mod] [list $modfile]
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"
unsetenv_var __MODULES_SHARE_FOO
set ans [list]
lappend ans [list set FOO /path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list unset __MODULES_PRIORITY_FOO]
testouterr_cmd sh "unload $mod" $ans {}

# unload, other element with priority remains
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&$mod|-100"
set ans [list]
lappend ans [list set FOO /path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10"]
testouterr_cmd sh "unload $mod" $ans {}

# unload, element still in variable, demand of unloaded module is withdrawn
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"
setenv_var __MODULES_SHARE_FOO /path/to/foo:2
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list unset __MODULES_PRIORITY_FOO]
testouterr_cmd sh "unload $mod" $ans {}

# unload, element still in variable, demand of other module is kept
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10&$mod|-100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"]
testouterr_cmd sh "unload $mod" $ans {}
unsetenv_var __MODULES_SHARE_FOO

# unload, variable becomes empty
setenv_var FOO /path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"
set ans [list]
lappend ans [list unset FOO]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list unset __MODULES_PRIORITY_FOO]
testouterr_cmd sh "unload $mod" $ans {}

# refresh
testouterr_cmd sh {refresh} OK {}

unsetenv_loaded_module
unsetenv_var FOO
unsetenv_var __MODULES_PRIORITY_FOO

# whatis
testouterr_cmd sh "whatis $mod" OK {}

# display
set tserr "$modlin
$mpre/$mod:

prepend-path\t--priority 100 FOO /path/to/foo
$modlin"
testouterr_cmd_re sh "display $mod" OK $tserr

# help
set tserr "$modlin
Module Specific Help for $mpre/$mod:

$warn_msgs: Unable to find ModulesHelp in $mpre/$mod.
$modlin"
testouterr_cmd_re sh "help $mod" OK $tserr

# test
set tserr "$modlin
Module Specific Test for $mpre/$mod:

$warn_msgs: Unable to find ModulesTest in $mpre/$mod.
$modlin"
testouterr_cmd_re sh "test $mod" OK $tserr

# scan
set tserr "$mpre:
$mod"
testouterr_cmd_re sh "avail -t $mod prepend-path:FOO" OK $tserr


#
# element already in variable with a priority set by another module
#

# element is not moved when path_entry_reorder is disabled, so the new
# demand is not recorded and the existing demand still applies
setenv_var TESTSUITE_PATH_PRIO prepend1

# same side, weaker existing demand
setenv_var FOO /path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-5"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-5"]
testouterr_cmd sh "load $mod" $ans {}

# same side, stronger existing demand
setenv_var FOO /path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-500:/path/to/foo&other/1.0|-5"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-500:/path/to/foo&other/1.0|-5"]
testouterr_cmd sh "load $mod" $ans {}

# prepend on appended element
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|10"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|10"]
testouterr_cmd sh "load $mod" $ans {}

# append on prepended element
setenv_var TESTSUITE_PATH_PRIO append1
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"]
testouterr_cmd sh "load $mod" $ans {}

# last demand decides when path_entry_reorder is enabled, element is moved
setenv_var MODULES_PATH_ENTRY_REORDER 1
setenv_var TESTSUITE_PATH_PRIO prepend1

# same side, weaker existing demand
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-5"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-5&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# same side, stronger existing demand
setenv_var FOO /path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-500:/path/to/foo&other/1.0|-5"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-500:/path/to/foo&other/1.0|-5&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# same side, weaker demand on stronger existing demand
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-500"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-50:/path/to/foo&other/1.0|-500&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# prepend on appended element
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|10"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|10&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# append on prepended element
setenv_var TESTSUITE_PATH_PRIO append1
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}

# append on prepended element with a weaker priority
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-1000"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-1000&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# module sets a different priority on an element it already prioritized:
# ignored when path_entry_reorder is disabled as element is not moved
setenv_var TESTSUITE_PATH_PRIO lead0
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}
unsetenv_var __MODULES_SHARE_FOO

# previous demand is replaced when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-7"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0
unsetenv_var __MODULES_SHARE_FOO

# other module demanded after the module: nothing changes when
# path_entry_reorder is disabled
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&$mod|-100&other/1.0|-20"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&$mod|-100&other/1.0|-20"]
testouterr_cmd sh "load $mod" $ans {}
unsetenv_var __MODULES_SHARE_FOO

# when path_entry_reorder is enabled, the previous demand of module is
# withdrawn and its new demand is the most recent one, so it applies
setenv_var MODULES_PATH_ENTRY_REORDER 1
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&other/1.0|-20&$mod|-7"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0
unsetenv_var __MODULES_SHARE_FOO


#
# element added with the same priority than another element
#

# elements of same priority form a group, prepended element is placed first
# in its group whether path_entry_reorder is enabled or not
setenv_var TESTSUITE_PATH_PRIO prepend1
setenv_var FOO /path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100"
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# group is placed after elements with higher priority
setenv_var FOO /path/to/baz:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/baz&other/1.0|-1000"
set ans [list]
lappend ans [list set FOO /path/to/baz:/path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/baz&other/1.0|-1000:/path/to/foo&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# appended element is placed last in its group
setenv_var TESTSUITE_PATH_PRIO append1
setenv_var FOO /bin:/path/to/bar
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100"
set ans [list]
lappend ans [list set FOO /bin:/path/to/bar:/path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# element already in variable with same priority set by another module: no
# move and no demand recorded when path_entry_reorder is disabled
setenv_var TESTSUITE_PATH_PRIO prepend1
setenv_var FOO /path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100"]
testouterr_cmd sh "load $mod" $ans {}

# element is moved first in its group when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}

# moved first in its group, not first in variable
setenv_var FOO /path/to/baz:/path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/baz&other/1.0|-1000:/path/to/foo&other/1.0|-100"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /path/to/baz:/path/to/foo:/path/to/bar:/bin]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/baz&other/1.0|-1000:/path/to/foo&other/1.0|-100&$mod|-100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# appended element already in variable with same priority set by another
# module: no move when path_entry_reorder is disabled
setenv_var TESTSUITE_PATH_PRIO append1
setenv_var FOO /bin:/path/to/foo:/path/to/bar
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&other/1.0|100"
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /bin:/path/to/foo:/path/to/bar]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&other/1.0|100"]
testouterr_cmd sh "load $mod" $ans {}

# element is moved last in its group when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
set ans [list]
lappend ans [list set __MODULES_SHARE_FOO /path/to/foo:2]
lappend ans [list set FOO /bin:/path/to/bar:/path/to/foo]
lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&other/1.0|100&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# unload: element removed, other element of same priority is not moved
setenv_var TESTSUITE_PATH_PRIO prepend1
setenv_loaded_module [list $mod] [list $modfile]
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&$mod|-100"
set ans [list]
lappend ans [list set FOO /path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100"]
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0

# unload: element still in variable, demand of unloaded module is withdrawn
# but same priority remains from other module so element is not moved
setenv_var __MODULES_SHARE_FOO /path/to/foo:2
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100&$mod|-100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100"]
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "unload $mod" $ans {}

# same when element is not first in its group
setenv_var FOO /path/to/bar:/path/to/foo:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&$mod|-100&other/1.0|-100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-100:/path/to/foo&other/1.0|-100"]
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0
testouterr_cmd sh "unload $mod" $ans {}

# unload: appended element still in variable, same priority remains
setenv_var TESTSUITE_PATH_PRIO append1
setenv_var FOO /bin:/path/to/foo:/path/to/bar
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&other/1.0|100&$mod|100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /bin:/path/to/foo:/path/to/bar]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|100:/path/to/foo&other/1.0|100"]
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 1
testouterr_cmd sh "unload $mod" $ans {}
setenv_var MODULES_PATH_ENTRY_REORDER 0
unsetenv_loaded_module
unsetenv_var __MODULES_SHARE_FOO


#
# masked priority demand is restored when module that set the effective
# one is unloaded
#

setenv_var TESTSUITE_PATH_PRIO append1
setenv_loaded_module [list $mod] [list $modfile]
setenv_var __MODULES_SHARE_FOO /path/to/foo:2

# demand of unloaded module withdrawn, element is not moved yet
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10&$mod|100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"]
testouterr_cmd sh "unload $mod" $ans {}
unsetenv_loaded_module

# restored demand applies at next change of variable
unsetenv_var __MODULES_SHARE_FOO
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"
set ans [list]
lappend ans [list set FOO /path/to/foo:/path/to/baz:/path/to/bar:/bin]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"]
testouterr_cmd sh {prepend-path FOO /path/to/baz} $ans {}

# element is moved at unload when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
setenv_loaded_module [list $mod] [list $modfile]
setenv_var __MODULES_SHARE_FOO /path/to/foo:2
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10&$mod|100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|-10"]
testouterr_cmd sh "unload $mod" $ans {}

# other element with priority already in its group, moved element is last
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&other/1.0|-10&$mod|100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/bar:/path/to/foo:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|-10:/path/to/foo&other/1.0|-10"]
testouterr_cmd sh "unload $mod" $ans {}

# no demand remains: element is not moved
setenv_var FOO /path/to/bar:/bin:/path/to/foo
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|100"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list unset __MODULES_PRIORITY_FOO]
testouterr_cmd sh "unload $mod" $ans {}
unsetenv_loaded_module
setenv_var MODULES_PATH_ENTRY_REORDER 0

# other way: first demand withdrawn, later demand becomes effective
setenv_var TESTSUITE_PATH_PRIO prepend1
setenv_loaded_module [list $mod] [list $modfile]
setenv_var __MODULES_SHARE_FOO /path/to/foo:2
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100&other/1.0|50"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/foo:/path/to/bar:/bin]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|50"]
testouterr_cmd sh "unload $mod" $ans {}
unsetenv_loaded_module

unsetenv_var __MODULES_SHARE_FOO
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|50"
set ans [list]
lappend ans [list set FOO /path/to/baz:/path/to/bar:/bin:/path/to/foo]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|50"]
testouterr_cmd sh {prepend-path FOO /path/to/baz} $ans {}

# element is moved at unload when path_entry_reorder is enabled
setenv_var MODULES_PATH_ENTRY_REORDER 1
setenv_loaded_module [list $mod] [list $modfile]
setenv_var __MODULES_SHARE_FOO /path/to/foo:2
setenv_var FOO /path/to/foo:/path/to/bar:/bin
setenv_var __MODULES_PRIORITY_FOO "/path/to/foo&$mod|-100&other/1.0|50"
set ans [list]
lappend ans [list unset __MODULES_SHARE_FOO]
lappend ans [list set FOO /path/to/bar:/bin:/path/to/foo]
lappend ans [list unset _LMFILES_]
lappend ans [list unset LOADEDMODULES]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/foo&other/1.0|50"]
testouterr_cmd sh "unload $mod" $ans {}
unsetenv_loaded_module
setenv_var MODULES_PATH_ENTRY_REORDER 0
unsetenv_var __MODULES_SHARE_FOO


#
# multiple prepended elements with priority, --priority=N form
#

setenv_var TESTSUITE_PATH_PRIO prepend2

setenv_var FOO /path/to/baz:/bin
