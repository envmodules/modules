lappend ans [list set _LMFILES_ $modfile]
lappend ans [list set LOADEDMODULES $mod]
lappend ans [list set __MODULES_PRIORITY_FOO "/path/to/bar&other/1.0|10:/path/to/foo&$mod|100"]
testouterr_cmd sh "load $mod" $ans {}

# prepended element with priority already in variable
setenv_var FOO /path/to/bar:/bin
