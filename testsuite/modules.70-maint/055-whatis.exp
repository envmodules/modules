##############################################################################
#   Modules Revision 3.0
#   Providing a flexible user environment
#
#   File:		modules.70-maint/%M%
#   Revision:		%I%
#   First Edition:	95/12/06
#   Last Mod.:		%U%, %G%
#
#   Authors:		Jens Hamisch, Jens.Hamisch@Strawberry.COM
#
#   Description:	Testuite testsequence
#   Command:		load
#   Modulefiles:	whatis/lines, whatis/multiple, whatis/none
#   Modulefiles:	whatis/single, whatis/string, bad
#   Sub-Command:
#
#   Comment:	%C{
#			Tests the 'module whatis' command for success
#			Tests the 'module whatis' command for failure
#		}C%
#
##############################################################################

#
#  Variables. This test forces a module load command. It will result in the
#    environment variables "_LMFILES_", "LOADEDMODULES" and "testsuite" to
#    be set up
#

set header "$modlin $modpathre $modlin"

set module_1 "whatis/none"
set module_2 "whatis/single"
set module_3 "whatis/multiple"
set module_4 "whatis/string"
set module_5 "whatis/lines"
set module_6 "NonExistent"
set module_7 "bad"

set whatis_2 "       whatis/single"
set whatis_3 "     whatis/multiple"
set whatis_4 "       whatis/string"
set whatis_5 "        whatis/lines"
set whatis_7 "           bad/after"

#
#  Test only for the csh
#

set ts_csh_1 ""
set ts_csh_2 "$header\n$whatis_2: Testsuite-Modulefile"
# different behavior than C-version: on Tcl-version multiple arguments provided on a single
# module-whatis call produce a single module-whatis line, not one line per passed argument
set ts_csh_3 "$header\n$whatis_3: Testsuite Whatis Modulefile"
set ts_csh_4 "$header\n$whatis_4: Testsuite Whatis Modulefile"
# module name is reported once, next whatis lines are aligned under text of
# first line
set text_pad [string repeat { } 22]
set ts_csh_5 "$header\n$whatis_5: Testsuite Whatis Modulefile\n${text_pad}Second line of whatis tokens"
set ts_csh_6 "$err_path'$module_6'"
set ts_csh_7 "$header\n$whatis_7: erroneous module test"

#
#  The tests
#

testouterr_cmd_re "csh" "whatis $module_1" "OK" "$ts_csh_1"
testouterr_cmd_re "csh" "whatis $module_2" "OK" "$ts_csh_2"
testouterr_cmd_re "csh" "whatis $module_3" "OK" "$ts_csh_3"

skip_if_quick_mode

testouterr_cmd_re "csh" "whatis $module_4" "OK" "$ts_csh_4"
testouterr_cmd_re "csh" "whatis $module_5" "OK" "$ts_csh_5"
testouterr_cmd_re "csh" "whatis $module_5 $module_2" "OK" "$ts_csh_5\n$whatis_2: Testsuite-Modulefile"

# command nickname tests
testouterr_cmd_re "csh" "wh $module_5" "OK" "$ts_csh_5"

set module_8 "verssort/1.8-2015-12-01"
set text_pad_8 [string repeat { } 25]

# whatis text is wrapped to terminal width, module name longer than its column
# shifts text start column
testouterr_cmd_re "csh" "-w 40 whatis $module_5" "OK" "$header\n$whatis_5: Testsuite Whatis\n${text_pad}Modulefile\n${text_pad}Second line of\n${text_pad}whatis tokens"
testouterr_cmd_re "csh" "whatis $module_8" "OK" "$header\n$module_8: module version sort test"
testouterr_cmd_re "csh" "-w 40 whatis $module_8" "OK" "$header\n$module_8: module version\n${text_pad_8}sort test"
# word longer than remaining width is kept whole on its own line
testouterr_cmd_re "csh" "-w 30 whatis $module_8" "OK" "$header\n$module_8: module\n${text_pad_8}version\n${text_pad_8}sort\n${text_pad_8}test"
testouterr_cmd_re "csh" "-w 10 whatis $module_8" "OK" "$header\n$module_8: module\n${text_pad_8}version\n${text_pad_8}sort\n${text_pad_8}test"
testouterr_cmd_re "csh" "-w 1 whatis $module_8" "OK" "$header\n$module_8: module\n${text_pad_8}version\n${text_pad_8}sort\n${text_pad_8}test"

# terse output mode: one line per whatis entry, each prefixed by module name
# without padding nor wrapping, modulepath reported as header line
set header_t "$modpathre:"
set ts_csh_5t "$header_t\n$module_5: Testsuite Whatis Modulefile\n$module_5: Second line of whatis tokens"
testouterr_cmd_re "csh" "--terse whatis $module_5" "OK" "$ts_csh_5t"
testouterr_cmd_re "csh" "-t whatis $module_5 $module_2" "OK" "$ts_csh_5t\n$module_2: Testsuite-Modulefile"
testouterr_cmd_re "csh" "whatis -t $module_8" "OK" "$header_t\n$module_8: module version sort test"
testouterr_cmd_re "csh" "-w 30 -t whatis $module_8" "OK" "$header_t\n$module_8: module version sort test"
testouterr_cmd_re "csh" "-t whatis $module_1" "OK" "$ts_csh_1"

# json output is not affected by terse mode
set ts_json_5 "{\"$modpathre\": {\n\"$module_5\": { \"name\": \"$module_5\", \"whatis\": \\\[ \"Testsuite Whatis Modulefile\", \"Second line of whatis tokens\" \\\]}\n}}"
testouterr_cmd_re "csh" "-j whatis $module_5" "OK" "$ts_json_5"
testouterr_cmd_re "csh" "-t -j whatis $module_5" "OK" "$ts_json_5"

# setup MODULEPATH with a trailing slash and an empty dir element
setenv_path_var MODULEPATH {} "$modpath/"
testouterr_cmd_re "csh" "whatis $module_1" "OK" "$ts_csh_1"

# restore MODULEPATH
setenv_path_var MODULEPATH $modpath


#
# the fail case, return value false
#
testouterr_cmd "csh" "whatis $module_6" "ERR" "$ts_csh_6"

# first pattern does not match
testouterr_cmd_re sh "whatis $module_6 $module_2" OK $ts_csh_2

# second pattern does not match
testouterr_cmd_re sh "whatis $module_2 $module_6" OK $ts_csh_2

# no pattern match
testouterr_cmd_re sh "whatis $module_6 unk" ERR $err_path'unk'\n$ts_csh_6

# one module unknown and one found but without whatis information
testouterr_cmd_re sh "whatis $module_6 $module_1" OK {}

#
# test with erroneous modulefile
# should not produce error message
#
testouterr_cmd_re "csh" "whatis $module_7" "OK" "$ts_csh_7"


#
# test when loaded environment is inconsistent
#

setenv_loaded_module [list foo bar] "/path/to/foo"

set ts_csh_8 "$err_loinconsist
  LOADEDMODULES=foo bar
  _LMFILES_=/path/to/foo"
testouterr_cmd_re "csh" "whatis $module_5" ERR $ts_csh_8

#
#  Cleanup
#

reset_test_env
