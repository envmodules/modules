# shellcheck shell=bash
#
# Bash commandline completion
#
_module_comgen_words() {
    local -a words
    local val
    # split candidate list on IFS without triggering shell expansion (command
    # substitution, arithmetic, ...): candidate words may come from module
    # names read off disk, which must never be treated as executable code
    IFS=$' \t\n' read -r -d '' -a words <<<"$1"
    for val in "${words[@]}"; do
        case "$val" in
            "$2"*) COMPREPLY[${#COMPREPLY[@]}]="$val" ;;
        esac
    done
}

_module_comgen_words_and_files() {
    local start=${#COMPREPLY[@]} i
    _module_comgen_words "$1" "$2"
    # do not append space to word completed if it is a directory (ends with /)
    for ((i = start; i < ${#COMPREPLY[@]}; i++)); do
        if [ "${COMPREPLY[i]: -1:1}" = '/' ]; then
            # Bash >=4.0 is required for compopt
            type compopt &>/dev/null && compopt -o nospace
            break
        fi
    done
}

_module_avail() {
    local cur="${1:-}"
    # skip avail call if word currently being completed is an option keyword
    if [ -z "$cur" ] || [ "${cur:0:1}" != '-' ]; then
        MODULES_SUBCMD_ALIAS='' module avail --color=never -s -t -S --no-indepth -o 'alias:indesym' "$cur" 2>&1
    fi
}

_module_spider() {
    local cur="${1:-}"
    # skip spider call if word currently being completed is an option keyword
    if [ -z "$cur" ] || [ "${cur:0:1}" != '-' ]; then
        MODULES_SUBCMD_ALIAS='' module spider --color=never -s -t -S --no-indepth -o 'alias:indesym' "$cur" 2>&1
    fi
}

_module_savelist() {
    MODULES_SUBCMD_ALIAS='' module savelist --color=never -s -t 2>&1 | sed '
        /No named collection\.$/d;
        /Named collection list$/d;
        /:$/d;'
}

_module_stashlist() {
    MODULES_SUBCMD_ALIAS='' module stashlist --color=never -s -t 2>&1 | sed '
        /No stash collection\.$/d;
        /Stash collection list$/d;
        /:$/d;'
}

_module_not_yet_loaded() {
    _module_avail "${1:-}" | sort | @SED_ERE@ "\%^(${LOADEDMODULES//:/|})$%d"
}

# Set REPLY to the sub-command designated by the word passed as argument if
# this word is an alias defined in MODULES_SUBCMD_ALIAS, or to this word
# otherwise. Set _module_alias_list to the names of the defined aliases.
_module_subcmd_alias() {
    local -a defs
    local def name target
    local name_re='^[A-Za-z0-9_][A-Za-z0-9_-]*$' target_re='^[a-z][a-z-]*$'

    REPLY="$1"
    _module_alias_list=''
    IFS=: read -r -a defs <<<"${MODULES_SUBCMD_ALIAS:-}"
    for def in "${defs[@]}"; do
        name="${def%%=*}"
        target="${def#*=}"
        # like module does, skip definitions made with unexpected characters:
        # names kept can safely be used as completion candidates
        if [[ $def == *=* && $name != ml && $name =~ $name_re\
            && $target =~ $target_re ]]; then
            _module_alias_list+=" $name"
            if [ "$name" = "$1" ]; then
                REPLY="$target"
            fi
        fi
    done
}

# Translate previous word if it is an alias set as sub-command name, which is
# the first word that is not an option. Expect prev and aliases variables to
# be local to the calling function.
_module_resolve_prev() {
    local i

    _module_subcmd_alias "$prev"
    aliases="$_module_alias_list"
    for ((i = 1; i < COMP_CWORD; i++)); do
        if [[ ${COMP_WORDS[i]} != -* && ${COMP_WORDS[i]} != "$1" ]]; then
            if [ "$i" -eq $((COMP_CWORD - 1)) ]; then
                prev="$REPLY"
            fi
            break
        fi
    done
}

_module_long_arg_list() {
    local cur="$1" i

    if [[ ${COMP_WORDS[COMP_CWORD-2]} == sw* ]]
    then
        _module_comgen_words_and_files "$(_module_not_yet_loaded "$cur")" "$cur"
        return
    fi
    for ((i = COMP_CWORD - 1; i > 0; i--))
        do _module_subcmd_alias "${COMP_WORDS[$i]}"
        case $REPLY in
        add|load)
            _module_comgen_words_and_files "$(_module_not_yet_loaded "$cur")" "$cur"
            break;;
        rm|delete|remove|unload|switch|swap)
            _module_comgen_words "${LOADEDMODULES//:/ }" "$cur"
            break;;
        esac
    done
}

_module() {
    local cur="$2" prev="$3" aliases

    COMPREPLY=()
    _module_resolve_prev ''

    case "$prev" in
    add|add-any|load|load-any|try-add|try-load)
                    _module_comgen_words_and_files "@comp_load_opts@ $(_module_not_yet_loaded "$cur")" "$cur";;
    avail)          _module_comgen_words_and_files "@comp_avail_opts@ $(_module_avail "$cur")" "$cur";;
    spider)         _module_comgen_words_and_files "@comp_avail_opts@ $(_module_spider "$cur")" "$cur";;
    edit)           _module_comgen_words_and_files "$(_module_avail "$cur")" "$cur";;
    aliases)  COMPREPLY=( $(compgen -W "@comp_aliases_opts@" -- "$cur") );;
    list)  COMPREPLY=( $(compgen -W "@comp_list_opts@" -- "$cur") );;
    savelist)  COMPREPLY=( $(compgen -W "@comp_savelist_opts@" -- "$cur") );;
    stashlist)  COMPREPLY=( $(compgen -W "@comp_stashlist_opts@" -- "$cur") );;
    stashpop)  _module_comgen_words "@comp_stashpop_opts@ $(_module_stashlist)" "$cur";;
    stashshow|stashrm)
                    _module_comgen_words "$(_module_stashlist)" "$cur";;
    clear)  COMPREPLY=( $(compgen -W "@comp_clear_opts@" -- "$cur") );;
    restore)  _module_comgen_words "@comp_restore_opts@ $(_module_savelist)" "$cur";;
    save|saveshow|describe|saverm|disable|is-saved)
                    _module_comgen_words "$(_module_savelist)" "$cur";;
    rm|delete|remove|unload)
                    _module_comgen_words "@comp_unload_opts@ ${LOADEDMODULES//:/ }" "$cur";;
    switch|swap)    _module_comgen_words "@comp_load_opts@ ${LOADEDMODULES//:/ }" "$cur";;
    unuse|is-used)  _module_comgen_words "${MODULEPATH//:/ }" "$cur";;
    use)    case "$cur" in
                -*) _module_comgen_words "@comp_use_opts@" "$cur";;
                *)  ;;               # let readline handle the completion
            esac;;
    -a|--append|cachebuild)   ;;               # let readline handle the completion
    display|help|show|test|path|paths|is-loaded|info-loaded)
                    _module_comgen_words_and_files "@comp_mfile_opts@ $(_module_avail "$cur")" "$cur";;
    is-avail)
                    _module_comgen_words_and_files "@comp_isavail_opts@ $(_module_avail "$cur")" "$cur";;
    lint)
                    _module_comgen_words_and_files "@comp_lint_opts@ $(_module_avail "$cur")" "$cur";;
    mod-to-sh)
                    _module_comgen_words_and_files "@comp_modtosh_opts@ $(_module_not_yet_loaded "$cur")" "$cur";;
    whatis)
                    _module_comgen_words_and_files "@comp_whatis_opts@ $(_module_avail "$cur")" "$cur";;
    apropos|keyword|search)
                    COMPREPLY=( $(compgen -W "@comp_search_opts@" -- "$cur") );;
    config|--reset) COMPREPLY=( $(compgen -W "@comp_config_opts@" -- "$cur") );;
    purge)  COMPREPLY=( $(compgen -W "@comp_purge_opts@" -- "$cur") );;
    reload|update)  COMPREPLY=( $(compgen -W "@comp_reload_opts@" -- "$cur") );;
    reset)  COMPREPLY=( $(compgen -W "@comp_reset_opts@" -- "$cur") );;
    stash)  COMPREPLY=( $(compgen -W "@comp_stash_opts@" -- "$cur") );;
    source)  case "$cur" in
                -*) COMPREPLY=( $(compgen -W "@comp_source_opts@" -- "$cur") );;
                *)  ;;               # let readline handle the completion
            esac;;
    sh-to-mod)  case "$cur" in
                -*) _module_comgen_words "@comp_shtomod_opts@" "$cur";;
                *)  ;;               # let readline handle the completion
            esac;;
    -h|--help|-V|--version|--dumpname|refresh|state|stashclear|cacheclear)
                    ;;
    append-path|prepend-path)
                    COMPREPLY=( $(compgen -W "@comp_path_opts@" -- "$cur") );;
    remove-path)
                    COMPREPLY=( $(compgen -W "@comp_rm_path_opts@" -- "$cur") );;
    *)  if test "$COMP_CWORD" -gt 2
        then
            _module_long_arg_list "$cur"
        else
            case "$cur" in
            # The mappings below are optional abbreviations for convenience
            ls)     COMPREPLY=( "list" );;      # map ls -> list
            sw*)    COMPREPLY=( "switch" );;

            -*)     COMPREPLY=( $(compgen -W "@comp_opts@" -- "$cur") );;
            *)      COMPREPLY=( $(compgen -W "@comp_opts@ @comp_cmds@$aliases" -- "$cur") );;
            esac
        fi;;
    esac
}

# define completion for ml command if command exists
if type -t ml >/dev/null; then
    _ml() {
        local cur="$2" prev="$3" aliases

        COMPREPLY=()
        # sub-command name comes after ml word when called through module
        _module_resolve_prev ml

        case "$prev" in
        add|add-any|load|load-any|try-add|try-load)
                        _module_comgen_words_and_files "@comp_load_opts@ $(_module_not_yet_loaded "$cur")" "$cur";;
        avail)          _module_comgen_words_and_files "@comp_avail_opts@ $(_module_avail "$cur")" "$cur";;
        spider)         _module_comgen_words_and_files "@comp_avail_opts@ $(_module_spider "$cur")" "$cur";;
        edit)           _module_comgen_words_and_files "$(_module_avail "$cur")" "$cur";;
        aliases)  COMPREPLY=( $(compgen -W "@comp_aliases_opts@" -- "$cur") );;
        list)  COMPREPLY=( $(compgen -W "@comp_list_opts@" -- "$cur") );;
        savelist)  COMPREPLY=( $(compgen -W "@comp_savelist_opts@" -- "$cur") );;
        stashlist)  COMPREPLY=( $(compgen -W "@comp_stashlist_opts@" -- "$cur") );;
        stashpop)  _module_comgen_words "@comp_stashpop_opts@ $(_module_stashlist)" "$cur";;
        stashshow|stashrm)
                    _module_comgen_words "$(_module_stashlist)" "$cur";;
        clear)  COMPREPLY=( $(compgen -W "@comp_clear_opts@" -- "$cur") );;
        restore)  _module_comgen_words "@comp_restore_opts@ $(_module_savelist)" "$cur";;
        save|saveshow|describe|saverm|disable|is-saved)
                        _module_comgen_words "$(_module_savelist)" "$cur";;
        rm|delete|remove|unload)
                        _module_comgen_words "@comp_unload_opts@ ${LOADEDMODULES//:/ }" "$cur";;
        switch|swap)    _module_comgen_words "@comp_load_opts@ ${LOADEDMODULES//:/ }" "$cur";;
        unuse|is-used)  _module_comgen_words "${MODULEPATH//:/ }" "$cur";;
        use)    case "$cur" in
                    -*) _module_comgen_words "@comp_use_opts@" "$cur";;
                    *)  ;;               # let readline handle the completion
                esac;;
        -a|--append|cachebuild)   ;;               # let readline handle the completion
        display|help|show|test|path|paths|is-loaded|info-loaded)
                        _module_comgen_words_and_files "@comp_mfile_opts@ $(_module_avail "$cur")" "$cur";;
        is-avail)
                        _module_comgen_words_and_files "@comp_isavail_opts@ $(_module_avail "$cur")" "$cur";;
        lint)
                        _module_comgen_words_and_files "@comp_lint_opts@ $(_module_avail "$cur")" "$cur";;
        mod-to-sh)
                        _module_comgen_words_and_files "@comp_modtosh_opts@ $(_module_not_yet_loaded "$cur")" "$cur";;
        whatis)
                        _module_comgen_words_and_files "@comp_whatis_opts@ $(_module_avail "$cur")" "$cur";;
        apropos|keyword|search)
                        COMPREPLY=( $(compgen -W "@comp_search_opts@" -- "$cur") );;
        config|--reset) COMPREPLY=( $(compgen -W "@comp_config_opts@" -- "$cur") );;
        purge)  COMPREPLY=( $(compgen -W "@comp_purge_opts@" -- "$cur") );;
        reload|update)  COMPREPLY=( $(compgen -W "@comp_reload_opts@" -- "$cur") );;
        reset)  COMPREPLY=( $(compgen -W "@comp_reset_opts@" -- "$cur") );;
        stash)  COMPREPLY=( $(compgen -W "@comp_stash_opts@" -- "$cur") );;
        source)  case "$cur" in
                    -*) COMPREPLY=( $(compgen -W "@comp_source_opts@" -- "$cur") );;
                    *)  ;;               # let readline handle the completion
                esac;;
        sh-to-mod)  case "$cur" in
                    -*) _module_comgen_words "@comp_shtomod_opts@" "$cur";;
                    *)  ;;               # let readline handle the completion
                esac;;
        -h|--help|-V|--version|--dumpname|refresh|state|stashclear|cacheclear)
                        ;;
        append-path|prepend-path)
                        COMPREPLY=( $(compgen -W "@comp_path_opts@" -- "$cur") );;
        remove-path)
                        COMPREPLY=( $(compgen -W "@comp_rm_path_opts@" -- "$cur") );;
        *)  if test "$COMP_CWORD" -gt 2
            then
                _module_long_arg_list "$cur"
            else
                case "$cur" in
                # The mappings below are optional abbreviations for convenience
                ls)     COMPREPLY=( "list" );;      # map ls -> list
                sw*)    COMPREPLY=( "switch" );;

                -*)     COMPREPLY=( $(compgen -W "@comp_opts@" -- "$cur") )
                        loaded_modules=""
                        for i in ${LOADEDMODULES//:/ }; do
                            loaded_modules+="-${i} "
                        done
                        _module_comgen_words "@comp_load_opts@ $loaded_modules" "$cur";;
                *)       _module_comgen_words_and_files "@comp_load_opts@ $(_module_not_yet_loaded "$cur")" "$cur"
                        COMPREPLY=( "${COMPREPLY[@]}" $(compgen -W "@comp_opts@ @comp_cmds@$aliases" -- "$cur") )
                        loaded_modules=""
                        for i in ${LOADEDMODULES//:/ }; do
                            loaded_modules+="-${i} "
                        done
                        _module_comgen_words "@comp_load_opts@ $loaded_modules" "$cur";;
                esac
            fi;;
        esac
    }
    complete -o default -F _ml ml
fi
complete -o default -F _module module
